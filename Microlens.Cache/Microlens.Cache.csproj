<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Authors>Microlens</Authors>
		<Copyright>Copyright © $([System.DateTime]::Now.Year) Microlens</Copyright>
		<Description>Stampede-protected, container-scoped in-process caching for .NET, built on Microsoft.Extensions.Caching.Memory. Runs each factory once per key for all concurrent callers, keeps serving the previous value while a refresh loads, and applies per-container TTL with native LRU or hand-rolled LFU eviction.</Description>

		<TargetFrameworks>net472;net48;netstandard2.0;net8.0;net10.0</TargetFrameworks>
		<OutputType>Library</OutputType>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>

		<RootNamespace>Microlens.Cache</RootNamespace>
		<AssemblyName>Microlens.Cache</AssemblyName>

		<PackageId>Microlens.Cache</PackageId>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>cache;caching;in-memory-cache;memory-cache;imemorycache;cache-stampede;single-flight;stale-while-revalidate;ttl;expiration;eviction;lru;lfu;performance;optimization;csharp</PackageTags>
		<EnablePackageValidation>true</EnablePackageValidation>
		<PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
		<PackageProjectUrl>https://github.com/microlens-solutions/cache</PackageProjectUrl>

		<RepositoryUrl>https://github.com/microlens-solutions/cache</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
		<PackageReference Include="PolySharp" Version="1.16.0">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
